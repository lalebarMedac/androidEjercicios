<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:gravity="bottom|end"
            android:text=""
            android:textSize="48sp" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:stretchColumns="*">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <Button
                    android:id="@+id/button"
                    style="@style/BotonNumero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/numero_1"
                    app:cornerRadius="4dp" />

                <Button
                    android:id="@+id/button2"
                    style="@style/BotonNumero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/numero_2"
                    app:cornerRadius="4dp" />

                <Button
                    android:id="@+id/button3"
                    style="@style/BotonNumero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/numero_3"
                    app:cornerRadius="4dp" />

                <Button
                    android:id="@+id/button4"
                    style="@style/BotonOperaciones"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/operacion_dividir"
                    app:cornerRadius="4dp" />
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <Button
                    android:id="@+id/button5"
                    style="@style/BotonNumero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/numero_4"
                    app:cornerRadius="4dp" />

                <Button
                    android:id="@+id/button6"
                    style="@style/BotonNumero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/numero_5"
                    app:cornerRadius="4dp" />

                <Button
                    android:id="@+id/button7"
                    style="@style/BotonNumero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/numero_6"
                    app:cornerRadius="4dp" />

                <Button
                    android:id="@+id/button8"
                    style="@style/BotonOperaciones"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/operacion_multiplicar"
                    app:cornerRadius="4dp" />
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <Button
                    android:id="@+id/button9"
                    style="@style/BotonNumero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/numero_7"
                    app:cornerRadius="4dp" />

                <Button
                    android:id="@+id/button10"
                    style="@style/BotonNumero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/numero_8"
                    app:cornerRadius="4dp" />

                <Button
                    android:id="@+id/button11"
                    style="@style/BotonNumero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/numero_9"
                    app:cornerRadius="4dp" />

                <Button
                    android:id="@+id/button12"
                    style="@style/BotonOperaciones"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/operacion_restar"
                    app:cornerRadius="4dp" />
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <Button
                    android:id="@+id/button13"
                    style="@style/BotonBorrar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/operacion_borrar"
                    app:cornerRadius="4dp" />

                <Button
                    android:id="@+id/button14"
                    style="@style/BotonNumero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/numero_0"
                    app:cornerRadius="4dp" />

                <Button
                    android:id="@+id/button15"
                    style="@style/BotonOperaciones"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/operacion_igual"
                    app:cornerRadius="4dp" />

                <Button
                    android:id="@+id/button16"
                    style="@style/BotonOperaciones"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/operacion_sumar"
                    app:cornerRadius="4dp" />
            </TableRow>

        </TableLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>